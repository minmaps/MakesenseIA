<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Makesense.Formats\Makesense.Formats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj-updated2\**\*.cs" />
    <EmbeddedResource Remove="obj-updated2\**\*" />
    <None Remove="obj-updated2\**\*" />
    <Page Remove="obj-updated2\**\*.xaml" />
    <Resource Remove="obj-updated2\**\*" />
  </ItemGroup>

  <Target Name="CopyNativeRuntime" AfterTargets="Build">
    <ItemGroup>
      <NativeRuntime Include="..\artifacts\core\$(Configuration)\*.dll" Condition="Exists('..\artifacts\core\$(Configuration)')" />
      <NativeRuntimePdb Include="..\artifacts\core\$(Configuration)\*.pdb" Condition="Exists('..\artifacts\core\$(Configuration)')" />
    </ItemGroup>

    <Copy SourceFiles="@(NativeRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(NativeRuntime)' != ''" />
    <Copy SourceFiles="@(NativeRuntimePdb)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(NativeRuntimePdb)' != ''" />
  </Target>
</Project>
